IDENTIFICATION DIVISION.
PROGRAM-ID. PARSER.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CSV    PIC X(30) VALUE "12,7,99,3".
01 WS-P1     PIC X(6)  VALUE "".
01 WS-P2     PIC X(6)  VALUE "".
01 WS-P3     PIC X(6)  VALUE "".
01 WS-P4     PIC X(6)  VALUE "".
01 WS-A      PIC 9(4)  VALUE 0.
01 WS-B      PIC 9(4)  VALUE 0.
01 WS-C      PIC 9(4)  VALUE 0.
01 WS-SUM    PIC 9(6)  VALUE 0.
01 WS-Q      PIC 9(6)  VALUE 0.
01 WS-R      PIC 9(6)  VALUE 0.
01 WS-POW    PIC 9(8)  VALUE 0.
01 WS-TEXT   PIC X(20) VALUE "a-b-c-d".
01 WS-DASHES PIC 9(3)  VALUE 0.
01 WS-CLEAN  PIC X(20) VALUE "".
01 WS-SUB    PIC X(4)  VALUE "".
01 WS-FLAG   PIC X     VALUE "N".
   88 OK-FLAG VALUE "Y".
01 WS-GRADE  PIC 9(3)  VALUE 0.

PROCEDURE DIVISION.
MAIN.
    UNSTRING WS-CSV DELIMITED BY "," INTO WS-P1 WS-P2 WS-P3 WS-P4.
    MOVE WS-P1 TO WS-A.
    MOVE WS-P2 TO WS-B.
    MOVE WS-P3 TO WS-C.
    ADD WS-A WS-B WS-C GIVING WS-SUM.
    DISPLAY "sum=" WS-SUM.
    IF WS-SUM = 0 THEN
        GO TO ERR-PARA
    END-IF.
    DIVIDE WS-SUM BY 3 GIVING WS-Q REMAINDER WS-R.
    DISPLAY "avg q=" WS-Q " r=" WS-R.
    COMPUTE WS-POW = (WS-A + 1) ** 2.
    DISPLAY "pow=" WS-POW.
    INSPECT WS-TEXT TALLYING WS-DASHES FOR ALL "-".
    DISPLAY "dashes=" WS-DASHES.
    INSPECT WS-TEXT REPLACING ALL "-" BY "/".
    DISPLAY "clean=" WS-TEXT.
    MOVE WS-TEXT(1:4) TO WS-SUB.
    DISPLAY "sub=" WS-SUB.
    MOVE 75 TO WS-GRADE.
    IF WS-GRADE = 70 OR 75 OR 80 THEN
        DISPLAY "milestone"
    END-IF.
    SET OK-FLAG TO TRUE.
    IF OK-FLAG THEN
        DISPLAY "ok"
    END-IF.
    GO TO DONE-PARA.
ERR-PARA.
    DISPLAY "empty input".
DONE-PARA.
    DISPLAY "end".
    STOP RUN.
