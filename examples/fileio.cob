IDENTIFICATION DIVISION.
PROGRAM-ID. FILEIO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT OUT-FILE ASSIGN TO "~fileio.dat"
        ORGANIZATION IS LINE SEQUENTIAL.
    SELECT IN-FILE ASSIGN TO "~fileio.dat"
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD OUT-FILE.
01 OUT-REC PIC X(20).
FD IN-FILE.
01 IN-REC PIC X(20).

WORKING-STORAGE SECTION.
01 WS-EOF   PIC X(1) VALUE "N".
01 WS-COUNT PIC 9(3) VALUE 0.

PROCEDURE DIVISION.
MAIN-PARA.
    OPEN OUTPUT OUT-FILE.
    MOVE "alpha" TO OUT-REC.
    WRITE OUT-REC.
    MOVE "beta" TO OUT-REC.
    WRITE OUT-REC.
    MOVE "gamma" TO OUT-REC.
    WRITE OUT-REC.
    CLOSE OUT-FILE.

    OPEN INPUT IN-FILE.
    PERFORM UNTIL WS-EOF = "Y"
        READ IN-FILE AT END MOVE "Y" TO WS-EOF
        NOT AT END DISPLAY "line: " IN-REC ADD 1 TO WS-COUNT
        END-READ
    END-PERFORM.
    CLOSE IN-FILE.
    DISPLAY "count: " WS-COUNT.
    STOP RUN.
