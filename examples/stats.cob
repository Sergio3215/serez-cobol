IDENTIFICATION DIVISION.
PROGRAM-ID. STATS.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-N      PIC 9(3)    VALUE 6.
01 WS-DATA   PIC 9(4)    OCCURS 6 TIMES.
01 WS-I      PIC 9(3)    VALUE 0.
01 WS-J      PIC 9(3)    VALUE 0.
01 WS-TMP    PIC 9(4)    VALUE 0.
01 WS-PASS   PIC 9(3)    VALUE 0.
01 WS-TARGET PIC 9(4)    VALUE 42.
01 WS-FOUND  PIC 9(3)    VALUE 0.
01 WS-SUM    PIC 9(7)    VALUE 0.
01 WS-AVG    PIC 9(5)V99 VALUE 0.
01 WS-MIN    PIC 9(4)    VALUE 9999.
01 WS-MAX    PIC 9(4)    VALUE 0.

PROCEDURE DIVISION.
MAIN.
    MOVE 23 TO WS-DATA(1).
    MOVE 11 TO WS-DATA(2).
    MOVE 42 TO WS-DATA(3).
    MOVE 4  TO WS-DATA(4).
    MOVE 16 TO WS-DATA(5).
    MOVE 8  TO WS-DATA(6).

    PERFORM BUBBLE VARYING WS-I FROM 1 BY 1 UNTIL WS-I >= WS-N
        AFTER WS-J FROM 1 BY 1 UNTIL WS-J > WS-N - WS-I.
    DISPLAY "sorted:".
    PERFORM SHOW VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N.

    PERFORM STATS-STEP VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N.
    COMPUTE WS-AVG = WS-SUM / WS-N.
    DISPLAY "min=" WS-MIN " max=" WS-MAX " avg=" WS-AVG.

    MOVE 0 TO WS-FOUND.
    PERFORM SEARCH-STEP VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N.
    IF WS-FOUND > 0 THEN
        DISPLAY "found " WS-TARGET " at pos " WS-FOUND
    ELSE
        DISPLAY WS-TARGET " not found"
    END-IF.
    STOP RUN.

BUBBLE.
    IF WS-DATA(WS-J) > WS-DATA(WS-J + 1) THEN
        MOVE WS-DATA(WS-J) TO WS-TMP
        MOVE WS-DATA(WS-J + 1) TO WS-DATA(WS-J)
        MOVE WS-TMP TO WS-DATA(WS-J + 1)
    END-IF.

SHOW.
    DISPLAY "  " WS-DATA(WS-I).

STATS-STEP.
    ADD WS-DATA(WS-I) TO WS-SUM.
    IF WS-DATA(WS-I) < WS-MIN THEN
        MOVE WS-DATA(WS-I) TO WS-MIN
    END-IF.
    IF WS-DATA(WS-I) > WS-MAX THEN
        MOVE WS-DATA(WS-I) TO WS-MAX
    END-IF.

SEARCH-STEP.
    IF WS-DATA(WS-I) = WS-TARGET THEN
        MOVE WS-I TO WS-FOUND
    END-IF.
