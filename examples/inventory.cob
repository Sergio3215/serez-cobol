IDENTIFICATION DIVISION.
PROGRAM-ID. INVENTORY.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT RPT ASSIGN TO "inventory.dat"
        ORGANIZATION IS LINE SEQUENTIAL.
    SELECT INP ASSIGN TO "inventory.dat"
        ORGANIZATION IS LINE SEQUENTIAL.
DATA DIVISION.
FILE SECTION.
FD RPT.
01 RPT-REC PIC X(60).
FD INP.
01 INP-REC PIC X(60).
WORKING-STORAGE SECTION.
01 WS-NAME   PIC X(8)    OCCURS 3 TIMES.
01 WS-PRICE  PIC 9(5)V99 OCCURS 3 TIMES.
01 WS-STOCK  PIC 9(4)    OCCURS 3 TIMES.
01 WS-I      PIC 9(3)    VALUE 0.
01 WS-J      PIC 9(3)    VALUE 0.
01 WS-VALUE  PIC 9(9)V99 VALUE 0.
01 WS-GRAND  PIC 9(11)V99 VALUE 0.
01 WS-GRAND-ED PIC $$,$$$,$$9.99 VALUE 0.
01 WS-LINE   PIC X(60)   VALUE "".
01 WS-EOF    PIC X        VALUE "N".
   88 DONE   VALUE "Y".
01 WS-CNT    PIC 9(3)     VALUE 0.
01 WS-TIER   PIC X(6)     VALUE "".
01 WS-CODE   PIC X(3)     VALUE "".
01 WS-MATRIX PIC 9(4)     OCCURS 9 TIMES.

PROCEDURE DIVISION.
MAIN.
    MOVE "WIDGET" TO WS-NAME(1).
    MOVE 19.99 TO WS-PRICE(1).
    MOVE 100 TO WS-STOCK(1).
    MOVE "GADGET" TO WS-NAME(2).
    MOVE 5.50 TO WS-PRICE(2).
    MOVE 2000 TO WS-STOCK(2).
    MOVE "GIZMO" TO WS-NAME(3).
    MOVE 250.00 TO WS-PRICE(3).
    MOVE 8 TO WS-STOCK(3).

    OPEN OUTPUT RPT.
    PERFORM BUILD-LINE VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 3.
    CLOSE RPT.

    OPEN INPUT INP.
    PERFORM READ-ONE UNTIL DONE.
    CLOSE INP.

    MOVE WS-GRAND TO WS-GRAND-ED.
    DISPLAY "Items: " WS-CNT " Grand: " WS-GRAND-ED.

    EVALUATE WS-GRAND
        WHEN 0 THRU 9999 DISPLAY "size=small"
        WHEN 10000 THRU 99999 DISPLAY "size=mid"
        WHEN OTHER DISPLAY "size=big"
    END-EVALUATE.

    PERFORM FILL-MATRIX VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 3
        AFTER WS-J FROM 1 BY 1 UNTIL WS-J > 3.
    DISPLAY "m22=" WS-MATRIX(5) " m33=" WS-MATRIX(9).

    MOVE "AB1" TO WS-CODE.
    IF WS-CODE IS NOT NUMERIC THEN
        DISPLAY "code not numeric"
    END-IF.
    STOP RUN.

BUILD-LINE.
    COMPUTE WS-VALUE = WS-PRICE(WS-I) * WS-STOCK(WS-I).
    ADD WS-VALUE TO WS-GRAND.
    STRING WS-NAME(WS-I) "=" WS-VALUE INTO WS-LINE.
    WRITE RPT-REC FROM WS-LINE.

READ-ONE.
    READ INP
        AT END SET DONE TO TRUE
        NOT AT END ADD 1 TO WS-CNT
            DISPLAY "row: " INP-REC
    END-READ.

FILL-MATRIX.
    COMPUTE WS-MATRIX((WS-I - 1) * 3 + WS-J) = WS-I * 10 + WS-J.
