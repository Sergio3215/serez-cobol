IDENTIFICATION DIVISION.
PROGRAM-ID. SPAGHETTI.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-STR   PIC X(20) VALUE "ab12 cd 345xy".
01 WS-LEN   PIC 9(3)  VALUE 13.
01 WS-I     PIC 9(3)  VALUE 1.
01 WS-CH    PIC X(1)  VALUE " ".
01 WS-WORDS PIC 9(3)  VALUE 0.
01 WS-NUMS  PIC 9(3)  VALUE 0.
01 WS-STATE PIC X(1)  VALUE "S".
01 WS-N     PIC 9(6)  VALUE 27.
01 WS-HALF  PIC 9(6)  VALUE 0.
01 WS-REM   PIC 9(6)  VALUE 0.
01 WS-STEPS PIC 9(5)  VALUE 0.

PROCEDURE DIVISION.
DRIVER.
    GO TO SCAN-INIT.

SCAN-INIT.
    MOVE 1 TO WS-I.
    MOVE "S" TO WS-STATE.
    GO TO SCAN-LOOP.

DEAD-CODE.
    DISPLAY "UNREACHABLE".
    GO TO DRIVER.

SCAN-LOOP.
    IF WS-I > WS-LEN
        GO TO SCAN-DONE
    END-IF.
    MOVE WS-STR(WS-I:1) TO WS-CH.
    IF WS-CH >= "0" AND WS-CH <= "9"
        GO TO ST-DIGIT
    END-IF.
    IF WS-CH >= "a" AND WS-CH <= "z"
        GO TO ST-ALPHA
    END-IF.
    MOVE "S" TO WS-STATE.
    GO TO SCAN-NEXT.

ST-DIGIT.
    IF WS-STATE = "N"
        GO TO SCAN-NEXT
    END-IF.
    ADD 1 TO WS-NUMS.
    MOVE "N" TO WS-STATE.
    GO TO SCAN-NEXT.

ST-ALPHA.
    IF WS-STATE = "W"
        GO TO SCAN-NEXT
    END-IF.
    ADD 1 TO WS-WORDS.
    MOVE "W" TO WS-STATE.

SCAN-NEXT.
    ADD 1 TO WS-I.
    GO TO SCAN-LOOP.

SCAN-DONE.
    DISPLAY "words=" WS-WORDS " nums=" WS-NUMS.
    GO TO COLLATZ.

COLLATZ.
    IF WS-N = 1
        GO TO COLLATZ-DONE
    END-IF.
    DIVIDE WS-N BY 2 GIVING WS-HALF REMAINDER WS-REM.
    IF WS-REM = 0
        MOVE WS-HALF TO WS-N
    ELSE
        COMPUTE WS-N = WS-N * 3 + 1
    END-IF.
    ADD 1 TO WS-STEPS.
    GO TO COLLATZ.

COLLATZ-DONE.
    DISPLAY "collatz(27) steps=" WS-STEPS.
    STOP RUN.
