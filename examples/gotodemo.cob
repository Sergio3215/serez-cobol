IDENTIFICATION DIVISION.
PROGRAM-ID. GOTODEMO.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-N PIC 9(3) VALUE 0.

PROCEDURE DIVISION.
START-PARA.
    DISPLAY "start".
    GO TO LOOP-PARA.

DEAD-PARA.
    DISPLAY "should never print".

LOOP-PARA.
    ADD 1 TO WS-N.
    DISPLAY "n=" WS-N.
    IF WS-N < 3 THEN
        GO TO LOOP-PARA
    END-IF.

DONE-PARA.
    DISPLAY "done".
    STOP RUN.
