// index — the single entry point for serez-cobol.
// Decides the direction purely from the input file extension and runs the
// matching engine. There are no sub-commands, just an input file.
//
//   <file>.cob / .cbl  → cobol.sz   (COBOL → Serez .sz)
//   <file>.sz          → serez.sz   (Serez .sz → COBOL)
//   anything else      → error
//
// Installed as a package (recommended):
//   sz run convert path/to/program.cob
//   sz run convert path/to/program.sz
// Or run the entry directly from the repo:
//   sz index.sz path/to/program.cob
//
// Options (no leading dashes — `sz` rejects unknown --flags before this runs):
//   clean   .cob input: leave the //@ annotations out of the generated .sz
//   sync    .sz  input: reconcile the //@ annotations with the code, in place

use permissions { OS, Env, File }

// Find the input file (first argument after this script) AND this script's own
// path, so the engine (cobol.sz/serez.sz) is resolved NEXT TO index.sz — not
// relative to the caller's CWD (which differs under `sz run convert`).
let file = "";
let scriptPath = "";
let past = false;
let clean = false;
let sync = false;
for (let a in Env.args()) {
    let al = a.toLowerCase();
    // Options carry no leading dashes: `sz` itself rejects unknown --flags
    // before this script ever runs.
    if (al == "clean" || al == "clean=true") { clean = true; }
    else if (al == "sync" || al == "sync=true") { sync = true; }
    else if (past) {
        if (file == "") { file = a; }
    } else if (al.endsWith("index.sz")) {
        scriptPath = a;
        past = true;
    }
}

let low = file.toLowerCase();
let engine = "";
if (low.endsWith(".cob") || low.endsWith(".cbl")) { engine = "cobol.sz"; }
else if (low.endsWith(".sz")) { engine = "serez.sz"; }

if (file == "") {
    out "usage: sz run convert <file.cob | file.sz> [clean | sync]";
    out "  clean   (.cob input)  omit the //@ annotations from the generated .sz";
    out "  sync    (.sz input)   reconcile the //@ annotations with the code";
} else if (engine == "cobol.sz" && sync) {
    out "ERROR: `sync` reconciles the //@ annotations of a .sz — it does not apply";
    out "to a COBOL input. Did you mean `clean`?";
} else if (engine == "serez.sz" && clean) {
    out "ERROR: `clean` controls whether the //@ annotations are written into a";
    out "generated .sz — it does not apply to a .sz input. Did you mean `sync`?";
} else if (engine == "") {
    out "ERROR: '" + file + "' is not a COBOL or Serez source.";
    out "Pass a .cob/.cbl (COBOL) file to translate to Serez, or a .sz file to translate to COBOL.";
} else {
    // Directory of index.sz (works whether the path uses \ or /). If there is
    // no directory component (bare "index.sz" run from the repo), fall back to
    // the plain engine name (CWD-relative), preserving the old behavior.
    let dir = "";
    let norm = scriptPath.replaceAll("\\", "/");
    let parts = norm.split("/");
    let i = 0;
    while (i < parts.length() - 1) {
        if (dir == "") { dir = parts[i]; } else { dir = dir + "/" + parts[i]; }
        i = i + 1;
    }
    let enginePath = engine;
    if (dir != "") { enginePath = dir + "/" + engine; }

    let argv = [enginePath, file];
    if (clean) { argv.push("clean"); }
    if (sync) { argv.push("sync"); }

    let r = null;
    unsafe { r = OS.exec("sz", argv); }
    let so = r.stdout.trim();
    let se = r.stderr.trim();
    if (so != "") { out so; }
    if (se != "") { out se; }
    if (r.code != 0) { exit(r.code); }
}
