// ─────────────────────────────────────────────────────────────────────────────
// serez-cobol — a COBOL → Serez (.sz) source-to-source translator.
//
// Translates a free-format COBOL program into an equivalent .sz program that runs
// on the serez-code interpreter. Depends only on the core (the exact `dec` type
// makes COBOL fixed-point / ROUNDED arithmetic faithful). No core changes.
//
// Usage:  sz cobol.sz <input.cob>     # writes <input>.sz next to it
//
// Supported (v1.0 path):
//   DATA: PIC 9/9V9/X, S, VALUE, ZERO/SPACE; level 88 condition names.
//   PROCEDURE: DISPLAY, MOVE, COMPUTE [ROUNDED], ADD/SUBTRACT/MULTIPLY/DIVIDE
//     ([GIVING] [ROUNDED]), INITIALIZE, ACCEPT, CONTINUE, STOP RUN (→ exit).
//     IF/ELSE/END-IF, EVALUATE/WHEN/WHEN OTHER/END-EVALUATE,
//     PERFORM <para> [<n> TIMES | UNTIL c | VARYING v FROM a BY b UNTIL c],
//     inline PERFORM ... END-PERFORM, paragraphs.
//   Conditions: = > < >= <=, GREATER/LESS/EQUAL [THAN/TO], AND/OR, 88-names.
// ─────────────────────────────────────────────────────────────────────────────

use permissions { File, Env }

// ── character classes ────────────────────────────────────────────────────────
fn bool isDigitCh(string c) { return "0123456789".includes(c); }
fn bool isAlphaCh(string c) {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_".includes(c);
}

// ── token helpers ── tokens are strings "T:value", T in {W,S,N,D,O} ───────────
fn string tkType(string t) { return t.substring(0, 1); }
fn string tkVal(string t)  { return t.substring(2); }
fn string tkUp(string t)   { return t.substring(2).toUpperCase(); }
fn bool isWord(string t, string up) { return tkType(t) == "W" && tkUp(t) == up; }
fn bool isDot(string t) { return tkType(t) == "O" && tkVal(t) == "."; }

// COBOL identifiers use '-'; .sz identifiers can't, so map '-' → '_'.
fn string szName(string cobName) { return cobName.replaceAll("-", "_"); }
fn string indentOf(int depth) {
    let s = "";
    let i = 0;
    while (i < depth) { s = s + "    "; i = i + 1; }
    return s;
}

// Normalize one source line for fixed-format COBOL: a 6-digit sequence area in
// cols 1-6 is stripped, col 7 is the indicator ('*'/'/' = comment), and cols
// beyond 72 are ignored. Free-format lines pass through unchanged.
fn string normalizeLine(string line) {
    let nlen = line.length();
    if (nlen >= 7) {
        let ind = line[6];
        let seq = true;
        let k = 0;
        while (k < 6) { if (!isDigitCh(line[k])) { seq = false; } k = k + 1; }
        if (seq) {
            if (ind == "*" || ind == "/") { return ""; }
            let endc = nlen;
            if (endc > 72) { endc = 72; }
            return line.substring(7, endc);
        }
        if (ind == "*" || ind == "/") {
            let blank = true;
            let m = 0;
            while (m < 6) { if (line[m] != " ") { blank = false; } m = m + 1; }
            if (blank) { return ""; }
        }
    }
    return line;
}

// ── 1. TOKENIZER ─────────────────────────────────────────────────────────────
fn [string] tokenizeAll([string] lines) {
    let toks = [];
    let picPending = false;   // next non-IS token after PIC/PICTURE is a raw mask
    for (let raw in lines) {
        let line = normalizeLine(raw.replaceAll("\r", ""));
        let trimmed = line.trim();
        if (trimmed.startsWith("*")) { continue; }   // whole-line comment
        let i = 0;
        let n = line.length();
        while (i < n) {
            let c = line[i];
            if (c == " " || c == "\t") {
                i = i + 1;
            } else if (picPending) {
                // read the PICTURE mask as one whitespace-delimited token
                let tok = "";
                while (i < n && line[i] != " " && line[i] != "\t") { tok = tok + line[i]; i = i + 1; }
                if (tok.toUpperCase() == "IS") {
                    // keep waiting for the mask
                } else {
                    if (tok.endsWith(".")) {
                        toks.push("M:" + tok.substring(0, tok.length() - 1));
                        toks.push("O:.");
                    } else {
                        toks.push("M:" + tok);
                    }
                    picPending = false;
                }
            } else if (c == "\"" || c == "'") {
                let q = c;
                i = i + 1;
                let s = "";
                while (i < n && line[i] != q) { s = s + line[i]; i = i + 1; }
                i = i + 1;
                toks.push("S:" + s);
            } else if (isDigitCh(c)) {
                let num = "";
                let isDec = false;
                let go = true;
                while (i < n && go) {
                    let ch = line[i];
                    if (isDigitCh(ch)) { num = num + ch; i = i + 1; }
                    else if (ch == "." && i + 1 < n && isDigitCh(line[i + 1])) {
                        num = num + ch; isDec = true; i = i + 1;
                    } else { go = false; }
                }
                if (isDec) { toks.push("D:" + num); } else { toks.push("N:" + num); }
            } else if (isAlphaCh(c)) {
                let w = "";
                while (i < n && (isAlphaCh(line[i]) || isDigitCh(line[i]) || line[i] == "-")) {
                    w = w + line[i]; i = i + 1;
                }
                toks.push("W:" + w);
                let wu = w.toUpperCase();
                if (wu == "PIC" || wu == "PICTURE") { picPending = true; }
            } else if (c == ">") {
                if (i + 1 < n && line[i + 1] == "=") { toks.push("O:>="); i = i + 2; }
                else { toks.push("O:>"); i = i + 1; }
            } else if (c == "<") {
                if (i + 1 < n && line[i + 1] == "=") { toks.push("O:<="); i = i + 2; }
                else { toks.push("O:<"); i = i + 1; }
            } else if (c == "*") {
                if (i + 1 < n && line[i + 1] == "*") { toks.push("O:**"); i = i + 2; }
                else { toks.push("O:*"); i = i + 1; }
            } else if (c == "(" || c == ")" || c == "." || c == "=" ||
                       c == "+" || c == "*" || c == "/" || c == "-" || c == ":") {
                toks.push("O:" + c);
                i = i + 1;
            } else {
                i = i + 1;
            }
        }
    }
    return toks;
}

// ── 2. PIC parsing ── returns "kind|scale" ── kind: int|dec|string ────────────
fn string picInfo(string mask) {
    let m = mask.toUpperCase();
    if (m.includes("X") || m.includes("A")) { return "string|0"; }
    // numeric-edited: Z (suppress), comma, $, '.', * → formatted on assignment
    if (m.includes("Z") || m.includes(",") || m.includes("$") || m.includes(".") || m.includes("*")) {
        let dot = m.indexOf(".");
        let sc = 0;
        if (dot >= 0) {
            let i = dot + 1;
            while (i < m.length()) {
                let c = m[i];
                if (c == "9" || c == "Z" || c == "*") { sc = sc + 1; }
                i = i + 1;
            }
        }
        return "edited|" + sc;
    }
    let vi = m.indexOf("V");
    if (vi >= 0) { return "dec|" + countNines(m.substring(vi + 1)); }
    return "int|0";
}
fn int countNines(string frag) {
    let f = frag.toUpperCase();
    let count = 0;
    let i = 0;
    let n = f.length();
    while (i < n) {
        let c = f[i];
        if (c == "9") { count = count + 1; i = i + 1; }
        else if (c == "(") {
            let num = "";
            i = i + 1;
            while (i < n && f[i] != ")") { num = num + f[i]; i = i + 1; }
            i = i + 1;
            count = count + parseInt(num);
        } else { i = i + 1; }
    }
    return count;
}

// ── 3. COLLECT WORKING-STORAGE VARIABLES + 88 CONDITION NAMES ──────────────────
// Variable entry:  "NAME|kind|scale|init"      (kind: int|dec|string)
// 88-cond entry:   "NAME|cc|0|<sz-condition>"  (e.g. "WS_FLAG == \"Y\"")
fn [string] collectVars([string] toks) {
    let vars = [];
    let n = toks.length();
    let i = 0;
    let inWS = false;
    let lastVarSz = "";
    let lastVarKind = "";
    while (i < n) {
        let t = toks[i];
        if (tkType(t) == "W") {
            let up = tkUp(t);
            // Collect from FILE SECTION (FD records) and WORKING-STORAGE alike.
            if (up == "WORKING-STORAGE" || up == "FILE" || up == "LINKAGE") { inWS = true; i = i + 1; continue; }
            if (up == "PROCEDURE") { break; }
        }
        if (!inWS) { i = i + 1; continue; }

        if (tkType(t) == "N" && i + 1 < n && tkType(toks[i + 1]) == "W") {
            let level = tkVal(t);
            let name = tkVal(toks[i + 1]);

            if (level == "88") {
                // 88 COND VALUE val.  → parent's value-equality condition
                let j = i + 2;
                let val = "";
                while (j < n && !isDot(toks[j])) {
                    let tj = toks[j];
                    if (isWord(tj, "VALUE") || isWord(tj, "VALUES")) { j = j + 1; continue; }
                    if (isWord(tj, "IS")) { j = j + 1; continue; }
                    if (tkType(tj) == "S") { val = "\"" + tkVal(tj) + "\""; }
                    else if (tkType(tj) == "N" || tkType(tj) == "D") {
                        if (lastVarKind == "dec") { val = tkVal(tj) + "m"; } else { val = tkVal(tj); }
                    }
                    j = j + 1;
                }
                vars.push(name + "|cc|0|" + lastVarSz + " == " + val);
                i = j;
                continue;
            }

            // a normal data item
            let j = i + 2;
            let mask = "";
            let init = "";
            let occ = 0;
            let inPic = false;
            let valNext = false;
            let initSet = false;
            while (j < n && !isDot(toks[j])) {
                let tj = toks[j];
                if (isWord(tj, "PIC") || isWord(tj, "PICTURE")) { inPic = true; j = j + 1; continue; }
                if (isWord(tj, "VALUE")) { inPic = false; valNext = true; j = j + 1; continue; }
                if (isWord(tj, "OCCURS")) {
                    inPic = false; j = j + 1;
                    if (j < n && tkType(toks[j]) == "N") { occ = parseInt(tkVal(toks[j])); j = j + 1; }
                    if (j < n && isWord(toks[j], "TIMES")) { j = j + 1; }
                    continue;
                }
                if (valNext) {
                    if (tkType(tj) == "S") { init = "\"" + tkVal(tj) + "\""; }
                    else if (tkType(tj) == "D" || tkType(tj) == "N") { init = tkVal(tj); }
                    else if (isWord(tj, "ZERO") || isWord(tj, "ZEROS") || isWord(tj, "ZEROES")) { init = "0"; }
                    else if (isWord(tj, "SPACE") || isWord(tj, "SPACES")) { init = "\"\""; }
                    initSet = true; valNext = false; j = j + 1; continue;
                }
                if (tkType(tj) == "M") { mask = tkVal(tj); inPic = false; j = j + 1; continue; }
                if (inPic) { mask = mask + tkVal(tj); j = j + 1; continue; }
                j = j + 1;
            }
            let info = picInfo(mask).split("|");
            let kind = info[0];
            let scale = parseInt(info[1]);
            if (mask == "") { kind = "group"; }   // no PIC ⇒ group item (organizational)
            let emask = "";
            if (kind == "edited") { emask = mask.toUpperCase(); }
            if (!initSet) {
                if (kind == "string" || kind == "edited") { init = "\"\""; } else { init = "0"; }
            }
            vars.push(name + "|" + kind + "|" + scale + "|" + init + "|" + occ + "|" + emask);
            lastVarSz = szName(name);
            lastVarKind = kind;
            i = j;
            continue;
        }
        i = i + 1;
    }
    return vars;
}

// ── lookups ───────────────────────────────────────────────────────────────────
fn int varIndex([string] vars, string name) {
    let i = 0;
    while (i < vars.length()) {
        if (vars[i].split("|")[0] == name) { return i; }
        i = i + 1;
    }
    return -1;
}
fn string varField([string] vars, string name, int field) {
    let idx = varIndex(vars, name);
    if (idx < 0) { return "?"; }
    return vars[idx].split("|")[field];
}
fn string varKind([string] vars, string name)  { return varField(vars, name, 1); }
fn int    varScale([string] vars, string name) {
    let idx = varIndex(vars, name);
    if (idx < 0) { return 0; }
    return parseInt(vars[idx].split("|")[2]);
}
fn int varOccurs([string] vars, string name) {
    let idx = varIndex(vars, name);
    if (idx < 0) { return 0; }
    let parts = vars[idx].split("|");
    if (parts.length() < 5) { return 0; }
    return parseInt(parts[4]);
}
fn string varMask([string] vars, string name) {
    let idx = varIndex(vars, name);
    if (idx < 0) { return ""; }
    let parts = vars[idx].split("|");
    if (parts.length() < 6) { return ""; }
    return parts[5];
}
// Reverse lookup: which file (cobol name) owns this FD record name?
fn string fileByRec([string] vars, string rec) {
    let i = 0;
    while (i < vars.length()) {
        let p = vars[i].split("|");
        if (p[1] == "file" && p.length() >= 5 && p[4] == rec) { return p[0]; }
        i = i + 1;
    }
    return "";
}

// ── FILE-CONTROL / FD scan ── entry: "fname|file|mode|path|recname" ────────────
fn [string] collectFiles([string] toks) {
    let files = [];
    let n = toks.length();
    // SELECT fname ASSIGN TO path
    let i = 0;
    while (i < n) {
        if (isWord(toks[i], "SELECT") && i + 1 < n && tkType(toks[i + 1]) == "W") {
            let fname = tkVal(toks[i + 1]);
            let path = fname;
            let j = i + 2;
            while (j < n && !isDot(toks[j]) && !isWord(toks[j], "SELECT")) {
                if (isWord(toks[j], "ASSIGN")) {
                    j = j + 1;
                    if (j < n && isWord(toks[j], "TO")) { j = j + 1; }
                    if (j < n) { path = tkVal(toks[j]); j = j + 1; }
                    continue;
                }
                j = j + 1;
            }
            files.push(fname + "|file|INPUT|" + path + "|");
            i = j;
            continue;
        }
        i = i + 1;
    }
    // FD fname → first following 01 record name
    i = 0;
    while (i < n) {
        if (isWord(toks[i], "FD") && i + 1 < n && tkType(toks[i + 1]) == "W") {
            let fname = tkVal(toks[i + 1]);
            let j = i + 2;
            while (j + 1 < n && !(tkType(toks[j]) == "N" && tkVal(toks[j]) == "01")) {
                if (isWord(toks[j], "FD")) { break; }
                j = j + 1;
            }
            let rec = "";
            if (j + 1 < n && tkType(toks[j]) == "N" && tkVal(toks[j]) == "01" && tkType(toks[j + 1]) == "W") {
                rec = tkVal(toks[j + 1]);
            }
            let k = 0;
            while (k < files.length()) {
                let p = files[k].split("|");
                if (p[0] == fname) { files[k] = p[0] + "|file|" + p[2] + "|" + p[3] + "|" + rec; }
                k = k + 1;
            }
            i = i + 2;
            continue;
        }
        i = i + 1;
    }
    // OPEN <mode> fname … → record the access mode
    i = 0;
    while (i < n) {
        if (isWord(toks[i], "OPEN")) {
            let j = i + 1;
            let mode = "INPUT";
            while (j < n && !isDot(toks[j]) && !isStmtKw(toks[j])) {
                let u = "";
                if (tkType(toks[j]) == "W") { u = tkUp(toks[j]); }
                if (u == "INPUT" || u == "OUTPUT" || u == "EXTEND" || u == "I-O") { mode = u; j = j + 1; continue; }
                if (tkType(toks[j]) == "W") {
                    let fname = tkVal(toks[j]);
                    let k = 0;
                    while (k < files.length()) {
                        let p = files[k].split("|");
                        if (p[0] == fname) { files[k] = p[0] + "|file|" + mode + "|" + p[3] + "|" + p[4]; }
                        k = k + 1;
                    }
                }
                j = j + 1;
            }
            i = j;
            continue;
        }
        i = i + 1;
    }
    return files;
}

// ── 4. EMIT WORKING-STORAGE AS .sz GLOBALS ────────────────────────────────────
fn string emitVars([string] vars) {
    let s = "";
    let i = 0;
    while (i < vars.length()) {
        let p = vars[i].split("|");
        let kind = p[1];
        if (kind == "file") {
            let f = szName(p[0]);
            s = s + "let " + f + "_lines = [];\nlet " + f + "_idx = 0;\nlet " + f + "_out = \"\";\n";
        } else if (kind != "cc" && kind != "group") {
            let name = szName(p[0]);
            let scale = parseInt(p[2]);
            let init = p[3];
            let occ = 0;
            if (p.length() >= 5) { occ = parseInt(p[4]); }
            let elem = init;
            if (kind == "dec") {
                if (init == "0") { elem = "0m"; } else { elem = init + "m"; }
                elem = "(" + elem + ").setScale(" + scale + ", \"down\")";
            } else if (kind == "int") {
                if (init == "") { elem = "0"; }
            }
            if (occ > 0) {
                // OCCURS table → array of `occ` initialized elements (1-indexed in COBOL)
                let arr = "[";
                let k = 0;
                while (k < occ) {
                    if (k > 0) { arr = arr + ", "; }
                    arr = arr + elem;
                    k = k + 1;
                }
                s = s + "let " + name + " = " + arr + "];\n";
            } else {
                s = s + "let " + name + " = " + elem + ";\n";
            }
        }
        i = i + 1;
    }
    return s + "\n";
}

// ── 5. OPERAND / EXPRESSION / CONDITION TRANSLATION ───────────────────────────
fn string operand([string] vars, string t) {
    let ty = tkType(t);
    if (ty == "W") {
        let up = tkUp(t);
        if (up == "ZERO" || up == "ZEROS" || up == "ZEROES") { return "0"; }
        if (up == "SPACE" || up == "SPACES") { return "\"\""; }
        let nm = tkVal(t);
        if (varKind(vars, nm) == "cc") { return "(" + varField(vars, nm, 3) + ")"; }
        return szName(nm);
    }
    if (ty == "S") { return "\"" + tkVal(t) + "\""; }
    if (ty == "D") { return tkVal(t) + "m"; }
    if (ty == "N") { return tkVal(t); }
    if (ty == "O") {
        let v = tkVal(t);
        if (v == "=") { return "=="; }
        return v;
    }
    return "";
}

// One token inside a condition (word relationals, logicals, 88-names).
fn string condToken([string] vars, string t) {
    if (tkType(t) == "W") {
        let u = tkUp(t);
        if (u == "AND") { return "&&"; }
        if (u == "OR")  { return "||"; }
        if (u == "GREATER") { return ">"; }
        if (u == "LESS") { return "<"; }
        if (u == "EQUAL" || u == "EQUALS") { return "=="; }
        if (u == "THAN" || u == "IS" || u == "TO") { return ""; }
        if (u == "NOT") { return "!"; }
    }
    return operand(vars, t);
}

fn bool isRelWord(string t) {
    if (tkType(t) != "W") { return false; }
    let u = tkUp(t);
    return u == "AND" || u == "OR" || u == "GREATER" || u == "LESS" || u == "EQUAL"
        || u == "EQUALS" || u == "THAN" || u == "IS" || u == "TO" || u == "NOT";
}

// Is `t` a relational operator (symbol or word) — used to fold "NOT >" etc.
fn bool isRelOpTok(string t) {
    if (tkType(t) == "O") {
        let v = tkVal(t);
        return v == ">" || v == "<" || v == ">=" || v == "<=" || v == "=";
    }
    if (tkType(t) == "W") {
        let u = tkUp(t);
        return u == "GREATER" || u == "LESS" || u == "EQUAL" || u == "EQUALS";
    }
    return false;
}
// The negation of a relational operator token (for COBOL "X NOT > Y").
fn string negRel(string t) {
    let v = "";
    if (tkType(t) == "O") { v = tkVal(t); }
    else {
        let u = tkUp(t);
        if (u == "GREATER") { v = ">"; }
        if (u == "LESS") { v = "<"; }
        if (u == "EQUAL" || u == "EQUALS") { v = "="; }
    }
    if (v == ">") { return "<="; }
    if (v == "<") { return ">="; }
    if (v == "=") { return "!="; }
    if (v == ">=") { return "<"; }
    if (v == "<=") { return ">"; }
    return "!=";
}

// Emit one operand, expanding an OCCURS subscript `NAME ( sub )` → `NAME[(sub)-1]`.
// Returns [newPos, text].
fn [any] emitRef([string] toks, int pos, [string] vars) {
    let n = toks.length();
    let t = toks[pos];
    if (tkType(t) == "W" && pos + 1 < n
        && tkType(toks[pos + 1]) == "O" && tkVal(toks[pos + 1]) == "(") {
        let nm = tkVal(t);
        // collect the parenthesized content; a ':' at depth 1 ⇒ reference modification
        let j = pos + 2;
        let depth = 1;
        let part1 = "";
        let part2 = "";
        let hasColon = false;
        while (j < n && depth > 0) {
            let tj = toks[j];
            if (tkType(tj) == "O" && tkVal(tj) == "(") {
                depth = depth + 1;
                if (hasColon) { part2 = part2 + "( "; } else { part1 = part1 + "( "; }
                j = j + 1; continue;
            }
            if (tkType(tj) == "O" && tkVal(tj) == ")") {
                depth = depth - 1;
                if (depth == 0) { j = j + 1; break; }
                if (hasColon) { part2 = part2 + ") "; } else { part1 = part1 + ") "; }
                j = j + 1; continue;
            }
            if (tkType(tj) == "O" && tkVal(tj) == ":" && depth == 1) { hasColon = true; j = j + 1; continue; }
            if (hasColon) { part2 = part2 + operand(vars, tj) + " "; }
            else { part1 = part1 + operand(vars, tj) + " "; }
            j = j + 1;
        }
        if (hasColon) {
            // COBOL ref-mod NAME(start:len) → 1-indexed substring → .substring(start-1, start-1+len)
            let st = "(" + part1.trim() + ") - 1";
            return [j, szName(nm) + ".substring(" + st + ", (" + st + ") + (" + part2.trim() + "))"];
        }
        if (varOccurs(vars, nm) > 0) {
            return [j, szName(nm) + "[(" + part1.trim() + ") - 1]"];
        }
        return [j, szName(nm) + "(" + part1.trim() + ")"];
    }
    if (tkType(t) == "W") { return [pos + 1, operand(vars, t)]; }
    return [pos + 1, operand(vars, t)];
}

// Emit an assignment target (possibly subscripted). Returns [newPos, lhsText, baseName].
fn [any] emitLhs([string] toks, int pos, [string] vars) {
    let n = toks.length();
    let base = tkVal(toks[pos]);
    let r = emitRef(toks, pos, vars);
    return [r[0], r[1], base];
}

// Statement-starting / clause-boundary keywords.
fn bool isStmtKw(string t) {
    if (tkType(t) != "W") { return false; }
    let u = tkUp(t);
    return u == "DISPLAY" || u == "MOVE" || u == "COMPUTE" || u == "ADD"
        || u == "SUBTRACT" || u == "MULTIPLY" || u == "DIVIDE" || u == "IF"
        || u == "ELSE" || u == "END-IF" || u == "PERFORM" || u == "STOP"
        || u == "ACCEPT" || u == "EVALUATE" || u == "WHEN" || u == "END-EVALUATE"
        || u == "END-PERFORM" || u == "CONTINUE" || u == "INITIALIZE"
        || u == "GO" || u == "NEXT" || u == "STRING" || u == "UNSTRING"
        || u == "INSPECT" || u == "OPEN" || u == "READ" || u == "WRITE"
        || u == "CLOSE" || u == "END-READ" || u == "CALL" || u == "SET";
}

// End of an operand/target list: a statement boundary, or an inline-clause word
// (AT / NOT / END / END-xxx) such as those in READ ... AT END / NOT AT END.
fn bool isTargetEnd(string t) {
    if (isDot(t) || isStmtKw(t)) { return true; }
    if (tkType(t) != "W") { return false; }
    let u = tkUp(t);
    return u == "AT" || u == "NOT" || u == "END" || u.startsWith("END-");
}

// Build an expression from pos until a stmt keyword / '.' / optional stop word.
fn [any] grabExpr([string] toks, int pos, [string] vars, string stopWord) {
    let n = toks.length();
    let j = pos;
    let expr = "";
    while (j < n) {
        let tj = toks[j];
        if (isDot(tj) || isStmtKw(tj)) { break; }
        if (stopWord != "" && isWord(tj, stopWord)) { break; }
        let r = emitRef(toks, j, vars);
        expr = expr + r[1] + " ";
        j = r[0];
    }
    return [j, expr.trim()];
}
// Build a condition from pos until a stmt keyword / '.' / optional stop word.
fn [any] grabCond([string] toks, int pos, [string] vars, string stopWord) {
    let n = toks.length();
    let j = pos;
    let cond = "";
    let prevOperand = "";   // last operand emitted (candidate implied subject)
    let lastSubj = "";      // subject of the most recent relation
    let lastOp = "";        // operator of the most recent relation
    while (j < n) {
        let tj = toks[j];
        if (isDot(tj) || isStmtKw(tj)) { break; }
        if (stopWord != "" && isWord(tj, stopWord)) { break; }
        if (isWord(tj, "THEN")) { j = j + 1; continue; }
        if (isWord(tj, "NOT")) {
            // "X NOT > Y" — NOT directly before a relop → negated operator
            if (j + 1 < n && isRelOpTok(toks[j + 1])) {
                cond = cond + negRel(toks[j + 1]) + " ";
                j = j + 2;
                continue;
            }
            // "NOT ( ... )" — logical negation of a parenthesized group
            if (j + 1 < n && tkType(toks[j + 1]) == "O" && tkVal(toks[j + 1]) == "(") {
                cond = cond + "!";
                j = j + 1;
                continue;
            }
            // "NOT <a> <relop> <b>" — negate the simple relation → !(a op b)
            let r1 = emitRef(toks, j + 1, vars);
            let k = r1[0];
            if (k < n && isRelOpTok(toks[k])) {
                let opv = condToken(vars, toks[k]);
                let m = k + 1;
                while (m < n && (isWord(toks[m], "THAN") || isWord(toks[m], "TO") || isWord(toks[m], "IS"))) { m = m + 1; }
                let r2 = emitRef(toks, m, vars);
                cond = cond + "!(" + r1[1] + " " + opv + " " + r2[1] + ") ";
                j = r2[0];
                continue;
            }
            // "NOT <88-name>" — negate the condition expression
            cond = cond + "!(" + r1[1] + ") ";
            j = k;
            continue;
        }
        if (tkType(tj) == "O" || isRelWord(tj)) {
            let piece = condToken(vars, tj);
            if (piece == "&&" || piece == "||") {
                cond = cond + piece + " ";
                j = j + 1;
                // abbreviated combined condition: "X = 1 OR 2" → "X==1 || X==2"
                if (lastSubj != "" && lastOp != "" && j < n) {
                    let nt = toks[j];
                    let isOperandTok = tkType(nt) == "N" || tkType(nt) == "D" || tkType(nt) == "S"
                        || (tkType(nt) == "W" && !isRelWord(nt) && !isWord(nt, "NOT"));
                    if (isOperandTok) {
                        let rr = emitRef(toks, j, vars);
                        let after = rr[0];
                        let followedByRel = after < n && isRelOpTok(toks[after]);
                        if (!followedByRel) {
                            cond = cond + lastSubj + " " + lastOp + " " + rr[1] + " ";
                            prevOperand = rr[1];
                            j = after;
                        }
                    }
                }
                continue;
            }
            if (piece != "") {
                cond = cond + piece + " ";
                if (piece == ">" || piece == "<" || piece == "==" || piece == ">=" || piece == "<=" || piece == "!=") {
                    lastSubj = prevOperand;
                    lastOp = piece;
                }
            }
            j = j + 1;
        } else {
            let r = emitRef(toks, j, vars);
            cond = cond + r[1] + " ";
            prevOperand = r[1];
            j = r[0];
        }
    }
    return [j, cond.trim()];
}

// ── 6. PROCEDURE DIVISION ─────────────────────────────────────────────────────
// Ordered paragraph names (szName'd), '|'-joined — used for PERFORM ... THRU.
fn string collectParagraphs([string] toks) {
    let n = toks.length();
    let start = -1;
    let i = 0;
    while (i < n) { if (isWord(toks[i], "PROCEDURE")) { start = i; break; } i = i + 1; }
    if (start < 0) { return ""; }
    i = start + 1;
    while (i < n && !isDot(toks[i])) { i = i + 1; }
    i = i + 1;
    let order = "";
    let atStart = true;   // a label is a WORD '.' only at the start of a sentence
    while (i < n) {
        let t = toks[i];
        if (isDot(t)) { atStart = true; i = i + 1; continue; }
        if (atStart && tkType(t) == "W" && !isStmtKw(t) && i + 1 < n && isDot(toks[i + 1])) {
            order = order + szName(tkVal(t)) + "|";
            i = i + 2;
            continue;
        }
        atStart = false;
        i = i + 1;
    }
    return order;
}

fn string collectPerformTargets([string] toks) {
    let targets = "";
    let n = toks.length();
    let i = 0;
    while (i < n) {
        if (isWord(toks[i], "PERFORM") && i + 1 < n && tkType(toks[i + 1]) == "W") {
            let nx = tkUp(toks[i + 1]);
            if (nx != "UNTIL" && nx != "VARYING") {
                targets = targets + szName(tkVal(toks[i + 1])) + "|";
            }
        }
        i = i + 1;
    }
    return targets;
}

fn string emitProcedure([string] toks, [string] vars) {
    let n = toks.length();
    let start = -1;
    let i = 0;
    while (i < n) {
        if (isWord(toks[i], "PROCEDURE")) { start = i; break; }
        i = i + 1;
    }
    if (start < 0) { return "// (no PROCEDURE DIVISION)\n"; }
    i = start + 1;
    while (i < n && !isDot(toks[i])) { i = i + 1; }
    i = i + 1;

    let funcs = "";
    let mainCalls = "";
    let curName = "";
    let curBody = "";
    let paraOrder = "";
    let paras = collectParagraphs(toks);   // ordered paragraph names (for PERFORM THRU)
    let curEof = "";       // eof flag var of the current READ (for AT END / NOT AT END)
    let closeStack = [];   // close-text per open block (for END-x and '.')
    let evalSubj = [];     // parallel: EVALUATE subject ("" for non-eval blocks)
    let evalSeen = [];     // parallel: "1" once a WHEN was emitted

    while (i < n) {
        let t = toks[i];
        let depth = closeStack.length();
        let ind = indentOf(depth + 1);

        // paragraph label: bare WORD + '.', only at sentence level (no open blocks)
        if (depth == 0 && tkType(t) == "W" && !isStmtKw(t) && i + 1 < n && isDot(toks[i + 1])) {
            if (curName == "") { mainCalls = mainCalls + curBody; }
            else {
                funcs = funcs + "fn " + szName(curName) + "_() " + r"{" + "\n" + curBody + "" + r"}" + "\n\n";
                paraOrder = paraOrder + szName(curName) + "|";
            }
            curName = tkVal(t);
            curBody = "";
            i = i + 2;
            continue;
        }

        // sentence terminator: close every open inline block
        if (isDot(t)) {
            while (closeStack.length() > 0) {
                let ct = closeStack.pop();
                evalSubj.pop();
                evalSeen.pop();
                curBody = curBody + ct;
            }
            i = i + 1;
            continue;
        }

        let kw = "";
        if (tkType(t) == "W") { kw = tkUp(t); }

        if (kw == "IF") {
            let r = grabCond(toks, i + 1, vars, "");
            curBody = curBody + ind + "if (" + r[1] + ") " + r"{" + "\n";
            closeStack.push(ind + "" + r"}" + "\n");
            evalSubj.push("");
            evalSeen.push("");
            i = r[0];
            continue;
        }
        if (kw == "ELSE") {
            curBody = curBody + ind + "" + r"}" + " else " + r"{" + "\n";
            i = i + 1;
            continue;
        }
        if (kw == "END-IF" || kw == "END-PERFORM" || kw == "END-EVALUATE" || kw == "END-READ") {
            if (closeStack.length() > 0) {
                let ct = closeStack.pop();
                evalSubj.pop();
                evalSeen.pop();
                curBody = curBody + ct;
            }
            i = i + 1;
            continue;
        }

        // READ <f> [NEXT] [RECORD] [INTO v] → self-contained read + EOF flag;
        // AT END / NOT AT END become independent if(eof)/if(!eof) clause blocks.
        if (kw == "READ") {
            let fname = tkVal(toks[i + 1]);
            let f = szName(fname);
            let rec = szName(varField(vars, fname, 4));
            let j = i + 2;
            if (j < n && isWord(toks[j], "NEXT")) { j = j + 1; }
            if (j < n && isWord(toks[j], "RECORD")) { j = j + 1; }
            let intoV = "";
            if (j < n && isWord(toks[j], "INTO")) { j = j + 1; intoV = szName(tkVal(toks[j])); j = j + 1; }
            let ev = "__eof" + i;
            curEof = ev;
            curBody = curBody + ind + "let " + ev + " = (" + f + "_idx >= " + f + "_lines.length());\n";
            let take = rec + " = " + f + "_lines[" + f + "_idx]; " + f + "_idx = " + f + "_idx + 1;";
            if (intoV != "") { take = take + " " + intoV + " = " + rec + ";"; }
            curBody = curBody + ind + "if (!" + ev + ") " + r"{" + " " + take + " " + r"}" + "\n";
            i = j;
            continue;
        }
        // close a pending READ clause block (AT END / NOT AT END) if one is open
        let topIsClause = closeStack.length() > 0 && evalSubj[closeStack.length() - 1] == "READCLAUSE";
        if (kw == "AT" && i + 1 < n && isWord(toks[i + 1], "END")) {
            if (topIsClause) { curBody = curBody + closeStack.pop(); evalSubj.pop(); evalSeen.pop(); }
            let ind2 = indentOf(closeStack.length() + 1);
            curBody = curBody + ind2 + "if (" + curEof + ") " + r"{" + "\n";
            closeStack.push(ind2 + "" + r"}" + "\n"); evalSubj.push("READCLAUSE"); evalSeen.push("");
            i = i + 2;
            continue;
        }
        if (kw == "NOT" && i + 1 < n && isWord(toks[i + 1], "AT")) {
            if (topIsClause) { curBody = curBody + closeStack.pop(); evalSubj.pop(); evalSeen.pop(); }
            let ind2 = indentOf(closeStack.length() + 1);
            curBody = curBody + ind2 + "if (!" + curEof + ") " + r"{" + "\n";
            closeStack.push(ind2 + "" + r"}" + "\n"); evalSubj.push("READCLAUSE"); evalSeen.push("");
            i = i + 3; // NOT AT END
            continue;
        }

        if (kw == "EVALUATE") {
            // subject: TRUE → conditions per WHEN; else value compared per WHEN
            let subj = "";
            if (isWord(toks[i + 1], "TRUE")) { subj = "TRUE"; i = i + 2; }
            else { let r = grabExpr(toks, i + 1, vars, ""); subj = r[1]; i = r[0]; }
            closeStack.push(ind + "" + r"}" + "\n");
            evalSubj.push(subj);
            evalSeen.push("");
            continue;
        }
        if (kw == "WHEN") {
            let top = closeStack.length() - 1;
            let subj = evalSubj[top];
            if (isWord(toks[i + 1], "OTHER")) {
                curBody = curBody + ind + "" + r"}" + " else " + r"{" + "\n";
                i = i + 2;
                continue;
            }
            let seen = evalSeen[top];
            let lead = "} else if";
            if (seen == "") { lead = "if"; evalSeen[top] = "1"; }
            // merge consecutive "WHEN a WHEN b ..." (no body between) into one OR
            let cond = "";
            let k = i + 1;
            let more = true;
            while (more) {
                let part = "";
                if (subj == "TRUE") {
                    let r = grabCond(toks, k, vars, "");
                    part = "(" + r[1] + ")";
                    k = r[0];
                } else {
                    // value, or a "v1 THRU v2" range
                    let r1 = emitRef(toks, k, vars);
                    let v1 = r1[1];
                    k = r1[0];
                    if (k < n && (isWord(toks[k], "THRU") || isWord(toks[k], "THROUGH"))) {
                        let r2 = emitRef(toks, k + 1, vars);
                        part = "(" + subj + " >= " + v1 + " && " + subj + " <= " + r2[1] + ")";
                        k = r2[0];
                    } else {
                        part = "(" + subj + " == " + v1 + ")";
                    }
                }
                if (cond == "") { cond = part; } else { cond = cond + " || " + part; }
                if (k + 1 < n && isWord(toks[k], "WHEN") && !isWord(toks[k + 1], "OTHER")) {
                    k = k + 1;
                } else {
                    more = false;
                }
            }
            curBody = curBody + ind + lead + " (" + cond + ") " + r"{" + "\n";
            i = k;
            continue;
        }

        if (kw == "PERFORM") {
            // inline forms (no paragraph name): UNTIL / VARYING / <n> TIMES … END-PERFORM
            let nx = toks[i + 1];
            if (isWord(nx, "UNTIL")) {
                let r = grabCond(toks, i + 2, vars, "");
                curBody = curBody + ind + "while (!(" + r[1] + ")) " + r"{" + "\n";
                closeStack.push(ind + "" + r"}" + "\n"); evalSubj.push(""); evalSeen.push("");
                i = r[0];
                continue;
            }
            if (isWord(nx, "VARYING")) {
                let res = emitVarying(toks, i + 2, vars, ind);
                curBody = curBody + res[1];
                closeStack.push(res[2]); evalSubj.push(""); evalSeen.push("");
                i = res[0];
                continue;
            }
            if (tkType(nx) == "N") {
                // PERFORM <n> TIMES … END-PERFORM
                let cnt = "__p" + i;
                curBody = curBody + ind + "let " + cnt + " = 0;\n";
                curBody = curBody + ind + "while (" + cnt + " < " + tkVal(nx) + ") " + r"{" + "\n";
                closeStack.push(ind + "    " + cnt + " = " + cnt + " + 1;\n" + ind + "" + r"}" + "\n");
                evalSubj.push(""); evalSeen.push("");
                i = i + 3; // n TIMES
                continue;
            }
            // out-of-line PERFORM <para> [...]
            let r = emitStmt(toks, i, vars, ind, paras);
            curBody = curBody + r[1];
            if (r[0] <= i) { i = i + 1; } else { i = r[0]; }
            continue;
        }

        // leaf statement
        let r = emitStmt(toks, i, vars, ind, paras);
        curBody = curBody + r[1];
        if (r[0] <= i) { i = i + 1; } else { i = r[0]; }
    }

    if (curName == "") { mainCalls = mainCalls + curBody; }
    else {
        funcs = funcs + "fn " + szName(curName) + "_() " + r"{" + "\n" + curBody + "" + r"}" + "\n\n";
        paraOrder = paraOrder + szName(curName) + "|";
    }

    // Driver: run paragraphs in source order with a program counter, so GO TO can
    // jump and STOP RUN (exit) halts before falling through into PERFORMed-only
    // paragraphs. Paragraphs are first-class function refs dispatched by index.
    let order = "";
    let refs = "";
    for (let nm in paraOrder.split("|")) {
        if (nm != "") {
            if (order != "") { order = order + ", "; refs = refs + ", "; }
            order = order + "\"" + nm + "\"";
            refs = refs + nm + "_";
        }
    }
    let driver = "";
    if (order != "") {
        driver = "let __order = [" + order + "];\n";
        driver = driver + "let __fns = [" + refs + "];\n";
        driver = driver + "let __pc = 0;\n";
        driver = driver + "while (__pc < __fns.length()) " + r"{" + "\n";
        driver = driver + "    __goto = \"\";\n";
        driver = driver + "    __fns[__pc]();\n";
        driver = driver + "    if (__goto == \"\") " + r"{" + " __pc = __pc + 1; " + r"}" + "\n";
        driver = driver + "    else " + r"{" + "\n";
        driver = driver + "        let __k = 0;\n";
        driver = driver + "        let __nx = -1;\n";
        driver = driver + "        while (__k < __order.length()) " + r"{" + " if (__order[__k] == __goto) " + r"{" + " __nx = __k; " + r"}" + " __k = __k + 1; " + r"}" + "\n";
        driver = driver + "        if (__nx >= 0) " + r"{" + " __pc = __nx; " + r"}" + " else " + r"{" + " __pc = __pc + 1; " + r"}" + "\n";
        driver = driver + "    " + r"}" + "\n";
        driver = driver + r"}" + "\n";
    }
    return "let __goto = \"\";\n\n" + funcs + "// ── main ──\n" + mainCalls + driver;
}

// PERFORM VARYING v FROM a BY b UNTIL c [AFTER w FROM .. BY .. UNTIL ..]  →
// (possibly nested) loop header + close text. Returns [newPos, header, closeText].
fn [any] emitVarying([string] toks, int pos, [string] vars, string ind) {
    let n = toks.length();
    let header = "";
    let close = "";
    let depth = 0;
    let j = pos;
    let more = true;
    while (more) {
        let base = tkVal(toks[j]);
        let v = szName(base);
        j = j + 1;
        if (j < n && isWord(toks[j], "FROM")) { j = j + 1; }
        let rf = grabExpr(toks, j, vars, "BY");
        let from = rf[1];
        j = rf[0];
        if (j < n && isWord(toks[j], "BY")) { j = j + 1; }
        let rb = grabExpr(toks, j, vars, "UNTIL");
        let by = rb[1];
        j = rb[0];
        if (j < n && isWord(toks[j], "UNTIL")) { j = j + 1; }
        // UNTIL condition stops at AFTER (next nested VARYING clause)
        let rc = grabCond(toks, j, vars, "AFTER");
        let cond = rc[1];
        j = rc[0];
        let cur = ind + indentOf(depth);
        // FROM/BY honor the loop variable's type (a dec index gets scaled).
        header = header + assign(vars, base, v, from, cur) + cur + "while (!(" + cond + ")) " + r"{" + "\n";
        // inner loops close first → prepend this loop's close
        close = assignExpr(vars, base, v, v + " + (" + by + ")", false, cur + "    ") + cur + r"}" + "\n" + close;
        depth = depth + 1;
        if (j < n && isWord(toks[j], "AFTER")) { j = j + 1; } else { more = false; }
    }
    return [j, header, close];
}

// ── 7. LEAF STATEMENTS ────────────────────────────────────────────────────────
// Emit the calls for a PERFORM <p1> THRU <p2> paragraph range, each at `ind`.
fn string performRange(string paras, string p1, string p2, string ind) {
    let names = paras.split("|");
    let body = "";
    let inR = false;
    for (let nm in names) {
        if (nm == p1) { inR = true; }
        if (inR && nm != "") { body = body + ind + nm + "_();\n"; }
        if (nm == p2) { inR = false; }
    }
    if (body == "") { body = ind + p1 + "_();\n"; }
    return body;
}
// Body run by one PERFORM iteration: a single paragraph (p2 == "") or a range.
fn string performBody(string paras, string p1, string p2, string ind) {
    if (p2 == "") { return ind + p1 + "_();\n"; }
    return performRange(paras, p1, p2, ind);
}

fn [any] emitStmt([string] toks, int pos, [string] vars, string ind, string paras) {
    let n = toks.length();
    let t = toks[pos];
    if (tkType(t) != "W") { return [pos + 1, ""]; }
    let kw = tkUp(t);

    if (kw == "DISPLAY") {
        let j = pos + 1;
        let parts = "";
        let first = true;
        while (j < n && !isStmtKw(toks[j]) && !isDot(toks[j]) && !isWord(toks[j], "WITH")) {
            let r = emitRef(toks, j, vars);
            if (r[1] != "") {
                if (first) { parts = r[1]; first = false; }
                else { parts = parts + " + " + r[1]; }
            }
            j = r[0];
        }
        // skip a trailing "WITH NO ADVANCING" (no-newline output is not emitted)
        while (j < n && !isDot(toks[j]) && !isStmtKw(toks[j])) { j = j + 1; }
        if (parts == "") { parts = "\"\""; }
        return [j, ind + "out " + parts + ";\n"];
    }

    if (kw == "MOVE") {
        let rs = emitRef(toks, pos + 1, vars);
        let src = rs[1];
        let j = rs[0];
        if (j < n && isWord(toks[j], "TO")) { j = j + 1; }
        // MOVE x TO a b c  — assign to every destination
        let code = "";
        while (j < n && !isTargetEnd(toks[j])) {
            let rl = emitLhs(toks, j, vars);
            code = code + assign(vars, rl[2], rl[1], src, ind);
            j = rl[0];
        }
        return [j, code];
    }

    if (kw == "COMPUTE") {
        // COMPUTE a [b c ...] = expr  — one or more destinations
        let dstLhs = [];
        let dstBase = [];
        let j = pos + 1;
        while (j < n && !(tkType(toks[j]) == "O" && tkVal(toks[j]) == "=")) {
            let rl = emitLhs(toks, j, vars);
            dstLhs.push(rl[1]); dstBase.push(rl[2]); j = rl[0];
        }
        if (j < n && tkType(toks[j]) == "O" && tkVal(toks[j]) == "=") { j = j + 1; }
        let expr = "";
        let rounded = false;
        while (j < n && !isStmtKw(toks[j]) && !isDot(toks[j])) {
            if (isWord(toks[j], "ROUNDED")) { rounded = true; j = j + 1; continue; }
            let r = emitRef(toks, j, vars);
            expr = expr + r[1] + " ";
            j = r[0];
        }
        let code = "";
        let k = 0;
        while (k < dstLhs.length()) {
            code = code + assignExpr(vars, dstBase[k], dstLhs[k], expr.trim(), rounded, ind);
            k = k + 1;
        }
        return [j, code];
    }

    if (kw == "ADD" || kw == "SUBTRACT" || kw == "MULTIPLY" || kw == "DIVIDE") {
        return emitArith(toks, pos, vars, ind, kw);
    }

    if (kw == "INITIALIZE") {
        let dstName = tkVal(toks[pos + 1]);
        let k = varKind(vars, dstName);
        let z = "0";
        if (k == "dec") { z = "(0m).setScale(" + varScale(vars, dstName) + ", \"down\")"; }
        else if (k == "string") { z = "\"\""; }
        return [pos + 2, ind + szName(dstName) + " = " + z + ";\n"];
    }

    if (kw == "ACCEPT") {
        // ACCEPT <var>  → read a line into the variable
        let dstName = tkVal(toks[pos + 1]);
        let j = pos + 2;
        // ACCEPT x FROM DATE/TIME → DateTime (skip the FROM clause)
        if (j < n && isWord(toks[j], "FROM")) { while (j < n && !isDot(toks[j]) && !isStmtKw(toks[j])) { j = j + 1; } }
        return [j, ind + szName(dstName) + " = readLine();\n"];
    }

    if (kw == "STRING") {
        // STRING a [DELIMITED BY x] b ... INTO dest [END-STRING]
        let j = pos + 1;
        let src = "";
        let first = true;
        while (j < n && !isWord(toks[j], "INTO") && !isDot(toks[j]) && !isStmtKw(toks[j])) {
            if (isWord(toks[j], "DELIMITED")) {
                j = j + 1;
                if (j < n && isWord(toks[j], "BY")) { j = j + 1; }
                if (j < n) { j = j + 1; } // SIZE / SPACE / literal
                continue;
            }
            let r = emitRef(toks, j, vars);
            if (r[1] != "") { if (first) { src = r[1]; first = false; } else { src = src + " + " + r[1]; } }
            j = r[0];
        }
        if (j < n && isWord(toks[j], "INTO")) { j = j + 1; }
        let dl = emitLhs(toks, j, vars);
        j = dl[0];
        // skip to end of statement (END-STRING / '.')
        while (j < n && !isDot(toks[j]) && !isStmtKw(toks[j]) && !isWord(toks[j], "END-STRING")) { j = j + 1; }
        if (j < n && isWord(toks[j], "END-STRING")) { j = j + 1; }
        if (src == "") { src = "\"\""; }
        return [j, ind + dl[1] + " = " + src + ";\n"];
    }

    if (kw == "UNSTRING") {
        // UNSTRING src DELIMITED BY d INTO a b c [END-UNSTRING]
        let rs = emitRef(toks, pos + 1, vars);
        let src = rs[1];
        let j = rs[0];
        let delim = "\" \"";
        if (j < n && isWord(toks[j], "DELIMITED")) {
            j = j + 1;
            if (j < n && isWord(toks[j], "BY")) { j = j + 1; }
            if (j < n) { delim = operand(vars, toks[j]); j = j + 1; }
        }
        if (j < n && isWord(toks[j], "INTO")) { j = j + 1; }
        let dests = [];
        while (j < n && !isDot(toks[j]) && !isStmtKw(toks[j]) && !isWord(toks[j], "END-UNSTRING")) {
            let dl = emitLhs(toks, j, vars);
            dests.push(dl[1]);
            j = dl[0];
        }
        if (j < n && isWord(toks[j], "END-UNSTRING")) { j = j + 1; }
        let tmp = "__u" + pos;
        let code = ind + "let " + tmp + " = (" + src + ").split(" + delim + ");\n";
        let k = 0;
        while (k < dests.length()) {
            code = code + ind + dests[k] + " = (" + k + " < " + tmp + ".length()) ? " + tmp + "[" + k + "] : \"\";\n";
            k = k + 1;
        }
        return [j, code];
    }

    if (kw == "INSPECT") {
        // INSPECT src TALLYING cnt FOR ALL x  |  REPLACING ALL a BY b
        let rs = emitRef(toks, pos + 1, vars);
        let src = rs[1];
        let j = rs[0];
        let code = ind + "// INSPECT\n";
        if (j < n && isWord(toks[j], "TALLYING")) {
            j = j + 1;
            let cl = emitLhs(toks, j, vars); j = cl[0];
            if (j < n && isWord(toks[j], "FOR")) { j = j + 1; }
            if (j < n && (isWord(toks[j], "ALL") || isWord(toks[j], "LEADING"))) { j = j + 1; }
            let needle = "\"\"";
            if (j < n) { needle = operand(vars, toks[j]); j = j + 1; }
            code = ind + cl[1] + " = (" + src + ").split(" + needle + ").length() - 1;\n";
        } else if (j < n && isWord(toks[j], "REPLACING")) {
            j = j + 1;
            if (j < n && (isWord(toks[j], "ALL") || isWord(toks[j], "LEADING") || isWord(toks[j], "FIRST"))) { j = j + 1; }
            let fromV = "\"\"";
            if (j < n) { fromV = operand(vars, toks[j]); j = j + 1; }
            if (j < n && isWord(toks[j], "BY")) { j = j + 1; }
            let toV = "\"\"";
            if (j < n) { toV = operand(vars, toks[j]); j = j + 1; }
            code = ind + rs[1] + " = (" + src + ").replaceAll(" + fromV + ", " + toV + ");\n";
        }
        while (j < n && !isDot(toks[j]) && !isStmtKw(toks[j])) { j = j + 1; }
        return [j, code];
    }

    if (kw == "SET") {
        // SET <88-name> TO TRUE  →  parent = value
        // SET <var> TO <n> | UP BY <n> | DOWN BY <n>
        let nm = tkVal(toks[pos + 1]);
        let j = pos + 2;
        if (varKind(vars, nm) == "cc") {
            let parts = varField(vars, nm, 3).split(" == ");
            let code = "";
            if (parts.length() >= 2) { code = ind + parts[0] + " = " + parts[1] + ";\n"; }
            // consume "TO TRUE" but stop at inline-clause words (NOT/AT/END/…)
            while (j < n && !isTargetEnd(toks[j])) { j = j + 1; }
            return [j, code];
        }
        let lhs = szName(nm);
        if (j < n && isWord(toks[j], "TO")) {
            let r = emitRef(toks, j + 1, vars);
            return [r[0], ind + lhs + " = " + r[1] + ";\n"];
        }
        if (j < n && (isWord(toks[j], "UP") || isWord(toks[j], "DOWN"))) {
            let opc = "+";
            if (isWord(toks[j], "DOWN")) { opc = "-"; }
            j = j + 1;
            if (j < n && isWord(toks[j], "BY")) { j = j + 1; }
            let r = emitRef(toks, j, vars);
            return [r[0], ind + lhs + " = " + lhs + " " + opc + " (" + r[1] + ");\n"];
        }
        while (j < n && !isDot(toks[j])) { j = j + 1; }
        return [j, ind + "// SET (unsupported form)\n"];
    }

    if (kw == "CALL") {
        // CALL "SUB" [USING ...] — external subprograms can't be auto-linked.
        let name = "";
        if (pos + 1 < n) { name = tkVal(toks[pos + 1]); }
        let j = pos + 1;
        while (j < n && !isDot(toks[j]) && !isStmtKw(toks[j])) { j = j + 1; }
        return [j, ind + "// CALL " + name + " — external subprogram (not linked in v2.0)\n"];
    }

    if (kw == "GO") {
        // GO TO <para>  (DEPENDING ON not supported yet)
        let j = pos + 1;
        if (j < n && isWord(toks[j], "TO")) { j = j + 1; }
        let target = szName(tkVal(toks[j]));
        j = j + 1;
        return [j, ind + "__goto = \"" + target + "\"; return;\n"];
    }

    if (kw == "CONTINUE" || kw == "NEXT") {
        let j = pos + 1;
        if (kw == "NEXT" && j < n && isWord(toks[j], "SENTENCE")) { j = j + 1; }
        return [j, ind + "// " + kw + "\n"];
    }

    if (kw == "PERFORM") {
        // out-of-line: PERFORM <para> [THRU <para2>] [<n> TIMES | UNTIL c | VARYING ...]
        let para = szName(tkVal(toks[pos + 1]));
        let j = pos + 2;
        let inner = ind + "    ";
        let p2 = "";
        if (j < n && (isWord(toks[j], "THRU") || isWord(toks[j], "THROUGH"))) {
            p2 = szName(tkVal(toks[j + 1]));
            j = j + 2;
        }
        let bodyOnce = performBody(paras, para, p2, inner);
        if (j < n && isWord(toks[j], "UNTIL")) {
            let r = grabCond(toks, j + 1, vars, "");
            return [r[0], ind + "while (!(" + r[1] + ")) " + r"{" + "\n" + bodyOnce + ind + r"}" + "\n"];
        }
        if (j < n && isWord(toks[j], "VARYING")) {
            let res = emitVarying(toks, j + 1, vars, ind);
            return [res[0], res[1] + bodyOnce + res[2]];
        }
        if (j < n && tkType(toks[j]) == "N") {
            let cnt = "__p" + pos;
            let times = tkVal(toks[j]);
            j = j + 1;
            if (j < n && isWord(toks[j], "TIMES")) { j = j + 1; }
            let body = ind + "let " + cnt + " = 0;\n" + ind + "while (" + cnt + " < " + times + ") " + r"{" + "\n";
            body = body + bodyOnce + inner + cnt + " = " + cnt + " + 1;\n" + ind + r"}" + "\n";
            return [j, body];
        }
        return [j, performBody(paras, para, p2, ind)];
    }

    if (kw == "OPEN") {
        let j = pos + 1;
        let mode = "INPUT";
        let code = "";
        while (j < n && !isDot(toks[j]) && !isStmtKw(toks[j])) {
            let u = "";
            if (tkType(toks[j]) == "W") { u = tkUp(toks[j]); }
            if (u == "INPUT" || u == "OUTPUT" || u == "EXTEND" || u == "I-O") { mode = u; j = j + 1; continue; }
            if (tkType(toks[j]) == "W") {
                let fname = tkVal(toks[j]);
                let f = szName(fname);
                let path = varField(vars, fname, 3);
                if (mode == "INPUT") {
                    code = code + ind + f + "_lines = File.read(\"" + path + "\").split(\"\\n\").filter((__ln) => __ln != \"\");\n";
                    code = code + ind + f + "_idx = 0;\n";
                } else {
                    code = code + ind + f + "_out = \"\";\n";
                }
            }
            j = j + 1;
        }
        return [j, code];
    }

    if (kw == "WRITE") {
        let rec = tkVal(toks[pos + 1]);
        let j = pos + 2;
        let srcExpr = szName(rec);
        if (j < n && isWord(toks[j], "FROM")) {
            j = j + 1;
            let rr = emitRef(toks, j, vars);
            srcExpr = rr[1];
            j = rr[0];
        }
        let fname = fileByRec(vars, rec);
        let f = szName(fname);
        return [j, ind + f + "_out = " + f + "_out + (\"\" + " + srcExpr + ") + \"\\n\";\n"];
    }

    if (kw == "CLOSE") {
        let j = pos + 1;
        let code = "";
        while (j < n && !isDot(toks[j]) && !isStmtKw(toks[j])) {
            if (tkType(toks[j]) == "W") {
                let fname = tkVal(toks[j]);
                let f = szName(fname);
                let mode = varField(vars, fname, 2);
                let path = varField(vars, fname, 3);
                if (mode == "OUTPUT" || mode == "EXTEND") {
                    code = code + ind + "File.write(\"" + path + "\", " + f + "_out);\n";
                }
            }
            j = j + 1;
        }
        return [j, code];
    }

    if (kw == "STOP") {
        let j = pos + 1;
        if (j < n && tkType(toks[j]) == "W") { j = j + 1; } // RUN
        return [j, ind + "exit(0);\n"];
    }

    // unknown: skip to next '.'
    let j = pos + 1;
    while (j < n && !isDot(toks[j])) { j = j + 1; }
    return [j, ind + "// unsupported: " + tkVal(t) + "\n"];
}

// ADD/SUBTRACT/MULTIPLY/DIVIDE with optional GIVING/ROUNDED (operands subscript-aware).
fn [any] emitArith([string] toks, int pos, [string] vars, string ind, string op) {
    let n = toks.length();
    let j = pos + 1;
    // leading operand(s) until a connector word / keyword / '.'
    let acc = "";
    let first = true;
    while (j < n && !isStmtKw(toks[j]) && !isDot(toks[j])
           && !isWord(toks[j], "TO") && !isWord(toks[j], "FROM") && !isWord(toks[j], "BY")
           && !isWord(toks[j], "INTO") && !isWord(toks[j], "GIVING")) {
        let r = emitRef(toks, j, vars);
        if (first) { acc = r[1]; first = false; } else { acc = acc + " + " + r[1]; }
        j = r[0];
    }
    let conn = "";
    if (j < n && tkType(toks[j]) == "W") { conn = tkUp(toks[j]); j = j + 1; }

    // target list right after the connector (each may be subscripted)
    let tgtLhs = [];
    let tgtBase = [];
    while (j < n && !isTargetEnd(toks[j])
           && !isWord(toks[j], "GIVING") && !isWord(toks[j], "REMAINDER")
           && !isWord(toks[j], "ROUNDED")) {
        let tl = emitLhs(toks, j, vars);
        tgtLhs.push(tl[1]); tgtBase.push(tl[2]); j = tl[0];
    }

    // optional GIVING <dest...>, REMAINDER <dest> and ROUNDED
    let giveLhs = [];
    let giveBase = [];
    let remLhs = "";
    let remBase = "";
    let rounded = false;
    while (j < n && !isTargetEnd(toks[j])) {
        if (isWord(toks[j], "GIVING")) {
            j = j + 1;
            while (j < n && !isTargetEnd(toks[j])
                   && !isWord(toks[j], "REMAINDER") && !isWord(toks[j], "ROUNDED")) {
                let gl = emitLhs(toks, j, vars);
                giveLhs.push(gl[1]); giveBase.push(gl[2]); j = gl[0];
            }
            continue;
        }
        if (isWord(toks[j], "REMAINDER")) {
            j = j + 1;
            let rl = emitLhs(toks, j, vars);
            remLhs = rl[1]; remBase = rl[2]; j = rl[0];
            continue;
        }
        if (isWord(toks[j], "ROUNDED")) { rounded = true; j = j + 1; continue; }
        j = j + 1;
    }

    let code = "";
    if (conn == "GIVING") {
        // ADD a b GIVING c [d ...] — every dest = sum of operands
        let k = 0;
        while (k < tgtLhs.length()) {
            code = code + assignExpr(vars, tgtBase[k], tgtLhs[k], "(" + acc + ")", rounded, ind);
            k = k + 1;
        }
    } else if (giveLhs.length() > 0) {
        // operand form with GIVING: the single target is an operand, dests = GIVING list
        let optgt = tgtLhs[0];
        let k = 0;
        while (k < giveLhs.length()) {
            let expr = "(" + acc + ")";
            if (op == "ADD")      { expr = optgt + " + (" + acc + ")"; }
            if (op == "SUBTRACT") { expr = optgt + " - (" + acc + ")"; }
            if (op == "MULTIPLY") { expr = "(" + acc + ") * " + optgt; }
            if (op == "DIVIDE") {
                if (conn == "BY") { expr = "(" + acc + ") / " + optgt; }
                else { expr = optgt + " / (" + acc + ")"; }
            }
            code = code + assignExpr(vars, giveBase[k], giveLhs[k], expr, rounded, ind);
            k = k + 1;
        }
        // DIVIDE ... GIVING q REMAINDER r  →  r = dividend - q * divisor
        if (remLhs != "" && op == "DIVIDE") {
            let dvd = acc;
            let dvs = optgt;
            if (conn == "INTO") { dvd = optgt; dvs = acc; }
            let rExpr = "(" + dvd + ") - (" + giveLhs[0] + " * (" + dvs + "))";
            code = code + assignExpr(vars, remBase, remLhs, rExpr, false, ind);
        }
    } else {
        // accumulate into each target: a TO b c  /  FROM b c  /  BY b c  /  INTO b c
        let k = 0;
        while (k < tgtLhs.length()) {
            let d = tgtLhs[k];
            let expr = d + " + (" + acc + ")";
            if (op == "SUBTRACT") { expr = d + " - (" + acc + ")"; }
            if (op == "MULTIPLY") { expr = "(" + acc + ") * " + d; }
            if (op == "DIVIDE")   { expr = d + " / (" + acc + ")"; }
            code = code + assignExpr(vars, tgtBase[k], d, expr, rounded, ind);
            k = k + 1;
        }
    }
    return [j, code];
}

// ── assignment helpers (apply dec scaling to the destination) ─────────────────
fn string assign([string] vars, string baseName, string lhs, string src, string ind) {
    let k = varKind(vars, baseName);
    if (k == "edited") {
        return ind + lhs + " = fmtPic(" + src + ", \"" + varMask(vars, baseName) + "\");\n";
    }
    if (k == "dec") {
        // `+ 0m` lifts an int/int-literal source to exact dec so setScale applies.
        return ind + lhs + " = ((" + src + ") + 0m).setScale(" + varScale(vars, baseName) + ", \"down\");\n";
    }
    return ind + lhs + " = " + src + ";\n";
}
fn string assignExpr([string] vars, string baseName, string lhs, string expr, bool rounded, string ind) {
    let k = varKind(vars, baseName);
    if (k == "edited") {
        return ind + lhs + " = fmtPic((" + expr + "), \"" + varMask(vars, baseName) + "\");\n";
    }
    if (k == "dec") {
        let mode = "down";
        if (rounded) { mode = "half-up"; }
        return ind + lhs + " = ((" + expr + ") + 0m).setScale(" + varScale(vars, baseName) + ", \"" + mode + "\");\n";
    }
    return ind + lhs + " = (" + expr + ");\n";
}

// ── 8. TOP-LEVEL TRANSLATE ────────────────────────────────────────────────────
fn bool anyEdited([string] vars) {
    let i = 0;
    while (i < vars.length()) {
        if (vars[i].split("|")[1] == "edited") { return true; }
        i = i + 1;
    }
    return false;
}

fn string translate(string src, string rtText) {
    let lines = src.replaceAll("\r", "").split("\n");
    let toks = tokenizeAll(lines);
    let vars = collectVars(toks);
    let files = collectFiles(toks);
    for (let e in files) { vars.push(e); }
    let header = "// Generated by serez-cobol from COBOL source.\n\n";
    if (files.length() > 0) { header = header + "use permissions " + r"{" + " File " + r"}" + "\n\n"; }
    let rt = "";
    if (anyEdited(vars) && rtText != "") { rt = rtText + "\n"; }
    return header + rt + emitVars(vars) + emitProcedure(toks, vars);
}

// ── 9. COPY (copybook) PREPROCESSOR ───────────────────────────────────────────
fn string dirOf(string path) {
    let idx = -1;
    let i = 0;
    while (i < path.length()) {
        let c = path[i];
        if (c == "/" || c == "\\") { idx = i; }
        i = i + 1;
    }
    if (idx < 0) { return ""; }
    return path.substring(0, idx + 1);
}
fn string readCopybook(string dir, string nm) {
    let cands = [dir + nm, dir + nm + ".cpy", dir + nm + ".CPY", dir + nm + ".cob", dir + nm + ".cbl"];
    for (let p in cands) { if (File.exists(p)) { return File.read(p); } }
    return "*> COPY " + nm + " (not found)";
}
// Splice copybook content where `COPY name.` appears (one level; REPLACING ignored).
fn string expandCopy(string src, string dir) {
    let lines = src.replaceAll("\r", "").split("\n");
    let outp = "";
    for (let raw in lines) {
        let tr = normalizeLine(raw).trim();
        if (tr.toUpperCase().startsWith("COPY ")) {
            let rest = tr.substring(5).trim();
            let nm = "";
            let k = 0;
            while (k < rest.length() && rest[k] != " " && rest[k] != ".") { nm = nm + rest[k]; k = k + 1; }
            nm = nm.replaceAll("\"", "");
            outp = outp + readCopybook(dir, nm) + "\n";
        } else {
            outp = outp + raw + "\n";
        }
    }
    return outp;
}

// ── 10. CLI DRIVER ────────────────────────────────────────────────────────────
let args = Env.args();
let inFile = "";
let scriptDir = "";
for (let a in args) {
    let low = a.toLowerCase();
    if (low.endsWith(".cob") || low.endsWith(".cbl")) { inFile = a; }
    if (low.endsWith("cobol.sz")) { scriptDir = dirOf(a); }
}
if (inFile == "") {
    out "serez-cobol — COBOL → Serez (.sz) translator";
    out "usage: sz cobol.sz <input.cob>";
} else {
    let raw = File.read(inFile);
    let expanded = expandCopy(raw, dirOf(inFile));
    let rtPath = scriptDir + "runtime/cobol_rt.sz";
    let rtText = "";
    if (File.exists(rtPath)) { rtText = File.read(rtPath); }
    let result = translate(expanded, rtText);
    let outFile = inFile.substring(0, inFile.length() - 4) + ".sz";
    File.write(outFile, result);
    out "translated " + inFile + " -> " + outFile;
}
